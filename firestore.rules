rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Replace these two values before deploying. UID—not email—is the authority.
    function approved() {
      return signedIn() && request.auth.uid in ['ty2E8bD4ALVEwmpHNp4fIyOVQ7m2', '5lOhcWjXGdZUKJ1kdhxgqKtX3HQ2', 'uwt7mhHGgqeaIxVcLXAv57gXULH2'];
    }
    function allowedValue(value) { return value in ['none', 'bookmark_now', 'bookmark_later']; }

    match /users/{uid} {
      allow get: if approved() && (uid == request.auth.uid || uid in ['ty2E8bD4ALVEwmpHNp4fIyOVQ7m2', '5lOhcWjXGdZUKJ1kdhxgqKtX3HQ2', 'uwt7mhHGgqeaIxVcLXAv57gXULH2']);
      allow list: if false;
      allow create: if approved() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'fcmTokens', 'approved'])
        && request.resource.data.name is string && request.resource.data.email is string
        && request.resource.data.fcmTokens is list && request.resource.data.approved == true;
      allow update: if approved() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'fcmTokens', 'approved'])
        && request.resource.data.approved == true
        && request.resource.data.name is string && request.resource.data.email is string
        && request.resource.data.fcmTokens is list;
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      allow get, list: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'value', 'link', 'viewedBy', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && allowedValue(request.resource.data.value)
        && request.resource.data.link is string
        && (request.resource.data.link == '' || request.resource.data.link.matches('https?://.+'))
        && (request.resource.data.value != 'none' || request.resource.data.link.matches('https?://.+'))
        && request.resource.data.viewedBy.size() == 0
        && request.resource.data.createdAt == request.time;
      // A viewer may add or update only their own display name in viewedBy.
      // They cannot alter the link, author, timestamp, or another user's view status.
      allow update: if approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        && request.resource.data.viewedBy.diff(resource.data.viewedBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.viewedBy[request.auth.uid] is string;
      allow delete: if false;
    }
  }
}
